{
  "name": "@indusautomationlabs/matterflux",
  "version": "0.1.0",
  "description": "A cinematic matter-to-energy transition for important UI actions.",
  "license": "MIT",
  "author": "Indus Automation Labs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/matterflux.iife.js",
  "jsdelivr": "./dist/matterflux.iife.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./styles.css": "./dist/matterflux.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs && tsup && node ./scripts/copy-assets.mjs",
    "clean": "node ./scripts/clean.mjs"
  },
  "keywords": [
    "animation",
    "canvas",
    "react",
    "nextjs",
    "transition",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzah105/matterflux.git"
  },
  "homepage": "https://indusautomationlabs.com/labs/matterflux",
  "bugs": {
    "url": "https://github.com/hamzah105/matterflux/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3"
  }
}
