{
  "name": "indus-automation-labs-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx app components lib",
    "matterflux:build": "npm --prefix packages/matterflux run build",
    "matterflux:zip": "npm run matterflux:build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-matterflux-zip.ps1"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": "24.x"
  }
}
